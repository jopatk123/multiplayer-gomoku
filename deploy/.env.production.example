# 复制为杭州运行目录的 .env。不要提交真实密钥。本服务无第三方登录密钥。

NODE_ENV=production
GOMOKU_HOST=0.0.0.0
GOMOKU_WS_PORT=18765

# 精确 Origin。网页版必须包含站点本身。
# Toy 正式页常见为 https://www.bilibili.com ；预览页 Origin 以实际 preview_url / iframe 为准。
# Origin 只用于来源限制，不是玩家身份。
GOMOKU_ALLOWED_ORIGINS=https://gomoku.jopatk.top,https://www.bilibili.com,https://m.bilibili.com

# 兼容 Toy 预览/正式容器常见宿主。部署后请在服务端日志核对 ws_origin_reject，再增补精确 Origin。
GOMOKU_ALLOWED_ORIGIN_HOST_SUFFIXES=.bilibili.com,.hdslb.com

GOMOKU_ALLOW_NO_ORIGIN=0
GOMOKU_ALLOW_LOCAL_ORIGINS=0

# 刷新或短暂闪断后可凭座位会话重连的宽限，默认 20 秒。超时则本局不计胜负结束。
# 宽限期间回合 5 秒超时与三整轮无人落子规则仍由服务端推进，不会暂停。
GOMOKU_RECONNECT_GRACE_MS=20000

GOMOKU_MAX_ROOMS=200
GOMOKU_MAX_CONNECTIONS=400
GOMOKU_MAX_MESSAGE_BYTES=4096
GOMOKU_CONNECT_PER_MIN=30
GOMOKU_MESSAGES_PER_SEC=20
GOMOKU_CREATE_PER_MIN=8
GOMOKU_IDLE_LOBBY_MS=900000
GOMOKU_IDLE_FINISHED_MS=1200000
GOMOKU_TICK_MS=50

# compose 使用的镜像名，需与新加坡 docker build -t 一致
GOMOKU_IMAGE=gomoku:latest
